from pprint import pprint
# читаем адресную книгу в формате CSV в список contacts_list
import csv
with open("phonebook_raw.csv", encoding="utf-8") as f:
  rows = csv.reader(f, delimiter=",")
  contacts_list = list(rows)
pprint(contacts_list)

normalized = []
for row in data:
    # Берём первые 3 элемента, склеиваем в одну строку, разделяем по пробелу
    fio_str = " ".join(row[:3]).strip()
    parts = fio_str.split(" ")

    lastname  = parts[0] if len(parts) > 0 else ""
    firstname = parts[1] if len(parts) > 1 else ""
    surname   = parts[2] if len(parts) > 2 else ""

    # Остальные поля (organization, position, phone, email) — начиная с индекса 3
    organization = row[3] if len(row) > 3 else ""
    position     = row[4] if len(row) > 4 else ""
    phone        = row[5] if len(row) > 5 else ""
    email        = row[6] if len(row) > 6 else ""

    normalized.append([
        lastname, firstname, surname,
        organization, position, phone, email
    ])

PHONE_PATTERN = re.compile(
    r"(\+?7|8)?[\s\-]*$?(\d{3})$?[\s\-]*(\d{3})[\s\-]*(\d{2})[\s\-]*(\d{2})"
    r"(?:\s*(?:доб\.?|ext\.?)\s*(\d+))?"
)
def normalize_phone(raw: str) -> str:
    if not raw or not raw.strip():
        return ""
    m = PHONE_PATTERN.search(raw)
    if not m:
        return raw  
    g1, g2, g3, g4, g5, ext = m.groups()
    # Собираем основной номер в формате +7(999)999-99-99
    main = f"+7({g2}){g3}-{g4}-{g5}"
    if ext:
        main += f" доб.{ext}"
    return main

for row in normalized:
    row[5] = normalize_phone(row[5])
merged_dict = {}  # ключ — (lastname, firstname) → итоговая строка

for row in normalized:
    key = (row[0], row[1])  # (lastname, firstname)

    if key not in merged_dict:
        merged_dict[key] = row[:] 
    else:
        existing = merged_dict[key]
        for i in range(len(existing)):
            if not existing[i] and row[i]:
                existing[i] = row[i]  
result = list(merged_dict.values())
with open("phonebook.csv", "w", encoding="utf-8") as f:
  datawriter = csv.writer(f, delimiter=',')
  # Вместо contacts_list подставьте свой список
  datawriter.writerows(contacts_list)
