    fio_str = " ".join(row[:3]).strip()
    parts = fio_str.split(" ")

    lastname  = parts[0] if len(parts) > 0 else ""
    firstname = parts[1] if len(parts) > 1 else ""
    surname   = parts[2] if len(parts) > 2 else ""

    # Остальные поля (organization, position, phone, email) — начиная с индекса 3
    organization = row[3] if len(row) > 3 else ""
    position     = row[4] if len(row) > 4 else ""
    phone        = row[5] if len(row) > 5 else ""
    email        = row[6] if len(row) > 6 else ""

